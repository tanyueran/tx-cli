{
  "name": "tx-cli-monorepo",
  "private": true,
  "version": "0.12.1",
  "description": "一个cli工具，支持创建项目，添加模版，与大模型对话",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @tanyueran/cli dev",
    "build": "pnpm --filter @tanyueran/cli build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit && pnpm --filter \"@tanyueran/*\" --if-present type-check",
    "deps:check": "depcruise --config .dependency-cruiser.mjs packages",
    "lint": "eslint packages/",
    "lint:fix": "eslint packages/ --fix",
    "clean": "pnpm --filter \"@tanyueran/*\" --if-present clean",
    "publish:cli": "node ./script/publish-cli.cjs",
    "changelog": "conventional-changelog -n ./changelog.config.mjs -i CHANGELOG.md -s -k packages/cli/package.json -t \"@tanyueran/cli@\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/**/*.ts": "eslint --fix --config ./eslint.config.mjs --no-warn-ignored"
  },
  "keywords": [
    "cli"
  ],
  "author": "tanyueran",
  "license": "ISC",
  "packageManager": "pnpm@10.5.2",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/connect": "^3.4.38",
    "@types/fs-extra": "11.0.4",
    "@types/node": "^26.4.1",
    "@types/prompts": "2.4.2",
    "@types/serve-static": "^1.15.8",
    "@vitest/coverage-v8": "^4.1.11",
    "conventional-changelog-cli": "5.0.0",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.9.1",
    "fs-extra": "11.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "picocolors": "1.1.1",
    "prompts": "2.4.2",
    "rollup": "4.46.2",
    "simple-git": "3.28.0",
    "tslib": "2.8.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tanyueran/tx-cli.git"
  }
}
