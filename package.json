{
  "name": "@tanyueran/cli",
  "version": "0.6.0",
  "description": "一个cli工具，支持创建项目，添加模版，与大模型对话",
  "main": "./dist/cli.js",
  "bin": {
    "tx-cli": "./bin/tx-cli"
  },
  "files": [
    "bin",
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx ./src/cli.ts",
    "build": "rollup --config rollup.config.mjs",
    "publish-pkg": "node ./script/publish.cjs",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": "eslint --fix",
    "test/**/*.ts": "eslint --fix"
  },
  "keywords": [
    "cli"
  ],
  "author": "tanyueran",
  "license": "ISC",
  "packageManager": "pnpm@10.5.2",
  "dependencies": {
    "commander": "12.1.0",
    "connect": "^3.7.0",
    "fs-extra": "11.1.1",
    "handlebars": "4.7.7",
    "open": "^10.2.0",
    "openai": "7.32.0",
    "picocolors": "1.1.1",
    "prompts": "2.4.2",
    "serve-static": "^2.2.0",
    "simple-git": "3.28.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/connect": "^3.4.38",
    "@types/fs-extra": "11.0.4",
    "@types/node": "^26.4.1",
    "@types/prompts": "2.4.2",
    "@types/serve-static": "^1.15.8",
    "@vitest/coverage-v8": "^4.1.11",
    "conventional-changelog-cli": "5.0.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "rollup": "4.46.2",
    "tslib": "2.8.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tanyueran/tx-cli.git"
  }
}
