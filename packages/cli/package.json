{
  "name": "@tanyueran/cli",
  "version": "0.12.0",
  "description": "一个cli工具，支持创建项目，添加模版，与大模型对话",
  "keywords": [
    "cli",
    "ai",
    "agent",
    "scaffold"
  ],
  "author": "tanyueran",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanyueran/tx-cli.git"
  },
  "homepage": "https://github.com/tanyueran/tx-cli#readme",
  "bugs": {
    "url": "https://github.com/tanyueran/tx-cli/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/cli.js",
  "bin": {
    "tx-cli": "./bin/tx-cli"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "tsx ./src/cli.ts",
    "build": "rollup --config rollup.config.mjs",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.80",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "12.1.0",
    "connect": "^3.7.0",
    "fs-extra": "11.1.1",
    "handlebars": "4.7.7",
    "open": "^10.2.0",
    "openai": "7.32.0",
    "picocolors": "1.1.1",
    "prompts": "2.4.2",
    "serve-static": "^2.2.0",
    "simple-git": "3.28.0"
  },
  "devDependencies": {
    "@tanyueran/agent-core": "workspace:*",
    "@tanyueran/agent-scaffold": "workspace:*",
    "@tanyueran/agent-common": "workspace:*",
    "@types/connect": "^3.4.38",
    "@types/fs-extra": "11.0.4",
    "@types/node": "^26.4.1",
    "@types/prompts": "2.4.2",
    "@types/serve-static": "^1.15.8",
    "typescript": "5.9.2",
    "tsx": "^4.23.13"
  }
}
