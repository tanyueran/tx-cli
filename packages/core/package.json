{
  "name": "@tx-cli/core",
  "version": "0.11.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./conversation/*": "./src/conversation/*",
    "./llm/*": "./src/llm/*",
    "./tools/*": "./src/tools/*",
