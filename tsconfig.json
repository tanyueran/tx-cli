{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@tanyueran/agent-core": ["packages/agent-core/src"],
      "@tanyueran/agent-core/*": ["packages/agent-core/src/*"],
      "@tanyueran/agent-common": ["packages/agent-common/src"],
      "@tanyueran/agent-common/*": ["packages/agent-common/src/*"],
      "@tanyueran/agent-scaffold": ["packages/agent-scaffold/src"],
      "@tanyueran/agent-scaffold/*": ["packages/agent-scaffold/src/*"],
      "@tanyueran/cli": ["packages/cli/src"],
      "@tanyueran/cli/*": ["packages/cli/src/*"]
    }
  },
  "include": ["./packages/*/test/**/*", "./global.d.ts"],
  "exclude": ["node_modules", "coverage"]
}
