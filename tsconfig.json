{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@tx-cli/core": ["packages/core/src"],
      "@tx-cli/core/*": ["packages/core/src/*"],
      "@tx-cli/shared": ["packages/shared/src"],
      "@tx-cli/shared/*": ["packages/shared/src/*"],
      "@tx-cli/scaffold": ["packages/scaffold/src"],
      "@tx-cli/scaffold/*": ["packages/scaffold/src/*"],
      "@tx-cli/cli": ["packages/cli/src"],
      "@tx-cli/cli/*": ["packages/cli/src/*"]
    }
  },
  "include": ["./packages/*/test/**/*", "./global.d.ts"],
  "exclude": ["node_modules", "coverage"]
}
